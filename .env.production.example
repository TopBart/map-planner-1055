# Copiez ce fichier en « .env.production » avant « npm run dist » / « npm run build:web ».
# Active l'écran de clé d'accès (laissez vide ou supprimez pour une version sans clé).
VITE_REQUIRE_KEY=1
# Adresse du serveur d'accès (obligatoire pour l'appli Windows ; la version web utilise son propre serveur).
VITE_SERVER_URL=https://votre-serveur.example.com
